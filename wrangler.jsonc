{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-nv",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d6854398-e2bd-4536-aa2f-363e68cee617","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a26002c7199e4bb087e9de3f172f7848" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
